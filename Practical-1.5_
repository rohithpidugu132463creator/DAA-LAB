{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyNjajnJqlgIuqZUtNfMcv2W"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"L8o9T_r9-eaz","executionInfo":{"status":"ok","timestamp":1785380970188,"user_tz":-330,"elapsed":37427,"user":{"displayName":"PIDUGU ROHITH mefgi","userId":"07102675863186023135"}},"outputId":"9be4f7d2-c5e7-4608-c174-8dd10c93560c"},"outputs":[{"output_type":"stream","name":"stdout","text":["Enter the number of elements: 4\n","Enter 4 elements:\n","78\n","99\n","85\n","99\n","\n","Sorted Array:\n","[78, 85, 99, 99]\n","\n","Execution Time: 0.000262 seconds\n","\n","Time Complexity:\n","Best Case    : O(n)\n","Average Case : O(n^2)\n","Worst Case   : O(n^2)\n","Space Complexity: O(1)\n"]}],"source":["import time\n","\n","# Input from the user\n","n = int(input(\"Enter the number of elements: \"))\n","\n","arr = []\n","print(f\"Enter {n} elements:\")\n","for i in range(n):\n","    arr.append(int(input()))\n","\n","# Start timer\n","start_time = time.time()\n","\n","# Insertion Sort\n","for i in range(1, n):\n","    key = arr[i]\n","    j = i - 1\n","\n","    while j >= 0 and arr[j] > key:\n","        arr[j + 1] = arr[j]\n","        j -= 1\n","\n","    arr[j + 1] = key\n","\n","# Stop timer\n","end_time = time.time()\n","\n","# Calculate execution time\n","execution_time = end_time - start_time\n","\n","# Display sorted array\n","print(\"\\nSorted Array:\")\n","print(arr)\n","\n","# Display execution time\n","print(f\"\\nExecution Time: {execution_time:.6f} seconds\")\n","\n","# Display time complexity\n","print(\"\\nTime Complexity:\")\n","print(\"Best Case    : O(n)\")\n","print(\"Average Case : O(n^2)\")\n","print(\"Worst Case   : O(n^2)\")\n","print(\"Space Complexity: O(1)\")\n"]}]}